# ==========================================================
# Copy this file to .env and fill it in. NEVER commit a real .env.
#
# Lookup order (see config/payment.php): the bootstrap loads
#   1. <project-root>/.env
#   2. <project-root>/config/.env
# The first file that exists wins; the second is not read.
# ==========================================================

APP_ENV=sandbox            # sandbox | production
APP_URL=http://localhost/split-payments-checkout/public
APP_DEBUG=true

# Database (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=coproducao
DB_USER=root
DB_PASS=

# ----------------------------------------------------------
# Asaas payment gateway
# ----------------------------------------------------------
# In sandbox, use the API key of your sandbox account (https://sandbox.asaas.com)
ASAAS_API_KEY=put_your_api_key_here
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
# Production base URL: https://api.asaas.com/v3

# A token that YOU define in the Asaas dashboard (Webhooks section). It is sent
# back on every webhook call in the 'asaas-access-token' header and verified here.
ASAAS_WEBHOOK_TOKEN=define_a_strong_token_here

# ----------------------------------------------------------
# Issuing / split model
# ----------------------------------------------------------
# platform  = YOUR account issues the charge; the split carries the main
#             producer (85%) plus the co-producer (15%)
# principal = the main producer's account issues the charge; the split carries
#             the co-producer only (15%)
ISSUER_MODE=platform

# ----------------------------------------------------------
# ESTIMATED fees (used only for display and for the initial database record).
# The REAL net amount comes from Asaas in the webhook (netValue field).
# ----------------------------------------------------------
FEE_PIX_FIXED=1.99
FEE_CARD_PERCENT=2.99
FEE_CARD_FIXED=0.49

# Security
APP_KEY=generate_a_random_32_char_string
RATE_LIMIT_MAX=10          # attempts
RATE_LIMIT_WINDOW=60       # seconds

# Admin (simple administration area)
# ADMIN_PASS_HASH holds a bcrypt HASH, never a plaintext password. Generate one with:
#   php -r "echo password_hash('your-password-here', PASSWORD_BCRYPT), PHP_EOL;"
# Leave it empty to disable this login path entirely; a users row with
# role=admin can always sign in with its own e-mail and password.
ADMIN_USER=admin
ADMIN_PASS_HASH=

# ----------------------------------------------------------
# E-mail
# ----------------------------------------------------------
# log  = sends nothing; writes the message to storage/logs/mail.log (use in dev)
# smtp = really sends (fill in the SMTP_* values below)
MAIL_DRIVER=log
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME="Área de Aulas"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls            # tls | ssl | (empty for no encryption)
